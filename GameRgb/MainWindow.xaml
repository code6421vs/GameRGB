<Window x:Class="GameRgb.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameRgb"
 Title="GameRGB" Icon="Assets/GameRgb.ico" Width="1280" Height="880" MinWidth="680" MinHeight="600" Background="{StaticResource WindowBackground}" Foreground="White" FontFamily="Segoe UI Variable Text" WindowStartupLocation="CenterScreen">
<Grid Margin="24">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Canvas Grid.RowSpan="3" IsHitTestVisible="False" Opacity=".28"><Ellipse Width="360" Height="360" Fill="#4C33CCFF" Canvas.Left="-180" Canvas.Top="-210"><Ellipse.Effect><BlurEffect Radius="95"/></Ellipse.Effect></Ellipse><Ellipse Width="420" Height="420" Fill="#45C934FF" Canvas.Right="-180" Canvas.Top="80"><Ellipse.Effect><BlurEffect Radius="120"/></Ellipse.Effect></Ellipse></Canvas>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal"><Border Width="54" Height="54" Background="#9A151D31" BorderBrush="#4A5A7D" BorderThickness="1" CornerRadius="16" Margin="0,0,13,0"><Image Source="/GameRgb;component/Assets/GameRgb.png" Width="43" Height="43"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="GameRGB" FontSize="31" FontWeight="Bold" Foreground="{StaticResource TitleGradient}"/><TextBlock Text="{DynamicResource Subtitle}" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="LanguageCombo" Width="126" Margin="0,0,10,0" ToolTip="{DynamicResource LanguageTip}" SelectionChanged="Language_Changed"><ComboBoxItem Content="繁體中文" Tag="TraditionalChinese"/><ComboBoxItem Content="English" Tag="English"/></ComboBox><Border Background="#D9182032" BorderBrush="#3E4A68" BorderThickness="1" CornerRadius="18" Padding="15,9" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#64748B" Margin="0,0,9,0"><Ellipse.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFFFFF" Opacity=".35"/></Ellipse.Effect></Ellipse><TextBlock x:Name="StatusText" Text="{DynamicResource NotConnected}" FontWeight="SemiBold"/></StackPanel></Border></StackPanel>
</Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,22,0,16">
<local:ResponsivePanel MinColumnWidth="460" Gap="18">
<StackPanel>
<GroupBox Header="1  OpenRGB"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBox x:Name="HostBox" Text="127.0.0.1" TextChanged="Settings_Changed"/><TextBox x:Name="PortBox" Grid.Column="1" Text="6742" Margin="8,0" TextChanged="Settings_Changed"/><Button x:Name="ConnectButton" Grid.Column="2" Content="{DynamicResource ConnectScan}" Click="Connect_Click"/>
</Grid>
<ListBox ItemsSource="{Binding Devices}" Margin="0,11,0,0" MinHeight="130" Background="#0F131C" BorderBrush="#293244" Foreground="White">
<ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" Foreground="White" Margin="6"/></DataTemplate></ListBox.ItemTemplate>
</ListBox></StackPanel></GroupBox>
<GroupBox Header="{DynamicResource AudioSourceHeader}"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ProcessCombo" ItemsSource="{Binding Processes}" DisplayMemberPath="DisplayName" SelectionChanged="Settings_Changed"/><Button Grid.Column="1" Content="{DynamicResource Refresh}" Click="Refresh_Click" Margin="8,0,0,0"/></Grid>
<TextBlock Text="{DynamicResource AudioHint}" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
</StackPanel></GroupBox>
</StackPanel>
<StackPanel>
<GroupBox Header="{DynamicResource LightingHeader}"><StackPanel>
<TextBlock Text="{DynamicResource ModeLabel}"/><ComboBox x:Name="ModeCombo" SelectedIndex="0" Margin="0,5,0,13" SelectionChanged="Settings_Changed">
<ComboBoxItem Tag="ThreeBand"><StackPanel Orientation="Horizontal"><Image Source="Assets/Modes/ThreeBand.png" Width="26" Height="26" Margin="0,0,9,0"/><TextBlock Text="{DynamicResource ModeThreeBand}" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
<ComboBoxItem Tag="VuMeter"><StackPanel Orientation="Horizontal"><Image Source="Assets/Modes/VuMeter.png" Width="26" Height="26" Margin="0,0,9,0"/><TextBlock Text="{DynamicResource ModeVu}" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
<ComboBoxItem Tag="SolidPulse"><StackPanel Orientation="Horizontal"><Image Source="Assets/Modes/SolidPulse.png" Width="26" Height="26" Margin="0,0,9,0"/><TextBlock Text="{DynamicResource ModePulse}" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
<ComboBoxItem Tag="MonoRing"><StackPanel Orientation="Horizontal"><Image Source="Assets/Modes/MonoRing.png" Width="26" Height="26" Margin="0,0,9,0"/><TextBlock Text="{DynamicResource ModeRing}" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
<ComboBoxItem Tag="StaticColor"><StackPanel Orientation="Horizontal"><Image Source="Assets/Modes/StaticColor.png" Width="26" Height="26" Margin="0,0,9,0"/><TextBlock Text="{DynamicResource ModeStatic}" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
</ComboBox>
<Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="{DynamicResource ColorStyle}"/><StackPanel x:Name="ColorStylePanel" Orientation="Horizontal" Margin="0,7,8,0">
<RadioButton x:Name="SolidColorStyle" GroupName="ColorStyle" IsChecked="True" Checked="ColorStyle_Checked" Margin="0,0,14,0" ToolTip="{DynamicResource Solid}"><StackPanel Orientation="Horizontal"><Ellipse Width="20" Height="20" Fill="#3B82F6" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Solid}" VerticalAlignment="Center"/></StackPanel></RadioButton>
<RadioButton x:Name="GradientColorStyle" GroupName="ColorStyle" Checked="ColorStyle_Checked" ToolTip="{DynamicResource Gradient}"><StackPanel Orientation="Horizontal"><Border Width="28" Height="20" CornerRadius="4" Margin="0,0,6,0"><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#3B82F6" Offset="0"/><GradientStop Color="#A855F7" Offset="1"/></LinearGradientBrush></Border.Background></Border><TextBlock Text="{DynamicResource Gradient}" VerticalAlignment="Center"/></StackPanel></RadioButton>
</StackPanel></StackPanel>
<StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Direction}"/><StackPanel x:Name="DirectionPanel" Orientation="Horizontal" Margin="0,7,0,0">
<RadioButton x:Name="LeftToRightDirection" GroupName="LightingDirection" IsChecked="True" Checked="Settings_Changed" Margin="0,0,14,0" ToolTip="{DynamicResource LeftToRightTip}"><StackPanel Orientation="Horizontal"><TextBlock Text="➜" FontSize="22" Foreground="#60A5FA" Margin="0,-5,5,-3"/><TextBlock Text="{DynamicResource LeftToRight}" VerticalAlignment="Center"/></StackPanel></RadioButton>
<RadioButton x:Name="RightToLeftDirection" GroupName="LightingDirection" Checked="Settings_Changed" ToolTip="{DynamicResource RightToLeftTip}"><StackPanel Orientation="Horizontal"><TextBlock Text="⬅" FontSize="18" Foreground="#A78BFA" Margin="0,-3,5,-2"/><TextBlock Text="{DynamicResource RightToLeft}" VerticalAlignment="Center"/></StackPanel></RadioButton>
</StackPanel></StackPanel>
</Grid>
<StackPanel x:Name="ColorPalettePanel" Margin="0,0,0,13">
<Grid x:Name="SingleColorPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Tag="Primary" Click="ColorSwatch_Click" Padding="0" Background="Transparent" ToolTip="{DynamicResource OpenPalette}"><Border x:Name="SingleColorPreview" Width="34" Height="27" CornerRadius="5" Background="#3B82F6" BorderBrush="#CBD5E1" BorderThickness="1"/></Button><TextBlock x:Name="SingleColorText" Grid.Column="1" Text="主色  #3B82F6" VerticalAlignment="Center" Margin="9,0" Foreground="{StaticResource Muted}"/></Grid>
<Grid x:Name="GradientColorPanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Button Tag="Primary" Click="ColorSwatch_Click" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="{DynamicResource ChooseStart}" Margin="0,0,6,0" HorizontalContentAlignment="Stretch"><Border x:Name="GradientStartPreview" Height="42" CornerRadius="10" Background="#3B82F6" BorderBrush="#A9C7FF" BorderThickness="1" Padding="8"><Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#3B82F6" Opacity=".35"/></Border.Effect><Border Background="#99070B14" CornerRadius="7" Padding="10,5" HorizontalAlignment="Stretch"><TextBlock x:Name="GradientStartText" Text="起始  #3B82F6" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border></Border></Button>
<Button Grid.Column="1" Tag="Secondary" Click="ColorSwatch_Click" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="{DynamicResource ChooseEnd}" Margin="6,0,0,0" HorizontalContentAlignment="Stretch"><Border x:Name="GradientEndPreview" Height="42" CornerRadius="10" Background="#A855F7" BorderBrush="#D8B4FE" BorderThickness="1" Padding="8"><Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#A855F7" Opacity=".35"/></Border.Effect><Border Background="#99070B14" CornerRadius="7" Padding="10,5" HorizontalAlignment="Stretch"><TextBlock x:Name="GradientEndText" Text="結束  #A855F7" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border></Border></Button>
</Grid>
</StackPanel>
<TextBlock Text="{DynamicResource AudioGain}"/><Grid Margin="0,5,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Slider x:Name="GainSlider" Minimum=".5" Maximum="8" Value="2" ValueChanged="GainSlider_ValueChanged"/><TextBlock Grid.Column="1" Text="{Binding ElementName=GainSlider,Path=Value,StringFormat={}{0:F1}x}" HorizontalAlignment="Right"/></Grid>
<TextBlock Text="{DynamicResource GainHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
<TextBlock Text="{DynamicResource Afterglow}"/><Grid Margin="0,5,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Slider x:Name="SmoothSlider" Minimum="0" Maximum=".95" Value=".8" ValueChanged="SmoothSlider_ValueChanged"/><TextBlock Grid.Column="1" Text="{Binding ElementName=SmoothSlider,Path=Value,StringFormat={}{0:P0}}" HorizontalAlignment="Right"/></Grid>
<TextBlock Text="{DynamicResource RefreshRate}"/><ComboBox x:Name="FpsCombo" SelectedIndex="1" Margin="0,5,0,0" SelectionChanged="Settings_Changed"><ComboBoxItem Content="{DynamicResource FpsCompat}" Tag="10"/><ComboBoxItem Content="{DynamicResource FpsRecommended}" Tag="20"/><ComboBoxItem Content="30 FPS" Tag="30"/><ComboBoxItem Content="60 FPS" Tag="60"/></ComboBox>
<TextBlock Text="{DynamicResource GpuHint}" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
</StackPanel></GroupBox>
<GroupBox Header="{DynamicResource RealtimeBands}"><StackPanel>
<TextBlock Text="{DynamicResource Bass}" Foreground="#FCA5A5"/><ProgressBar x:Name="BassMeter" Height="12" Maximum="1" Margin="0,4,0,8" Foreground="#EF4444"/>
<TextBlock Text="{DynamicResource Mid}" Foreground="#86EFAC"/><ProgressBar x:Name="MidMeter" Height="12" Maximum="1" Margin="0,4,0,8" Foreground="#22C55E"/>
<TextBlock Text="{DynamicResource Treble}" Foreground="#93C5FD"/><ProgressBar x:Name="TrebleMeter" Height="12" Maximum="1" Margin="0,4,0,0" Foreground="#3B82F6"/>
</StackPanel></GroupBox>
</StackPanel>
</local:ResponsivePanel>
</ScrollViewer>
<Border Grid.Row="2" Background="#CC12192A" BorderBrush="#35415D" BorderThickness="1" CornerRadius="16" Padding="14,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock x:Name="MessageText" Text="{DynamicResource PreparingOpenRgb}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
<StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="TestButton" Content="{DynamicResource EffectTest}" Click="Test_Click" IsEnabled="False" Background="#7C3AED" Margin="0,0,10,0"/><Button x:Name="StopButton" Content="{DynamicResource StopRestore}" Click="Stop_Click" IsEnabled="False" Background="#334155" Margin="0,0,10,0"/><Button x:Name="StartButton" Content="{DynamicResource StartEffect}" Click="Start_Click" IsEnabled="False" MinWidth="120"/></StackPanel>
</Grid></Border>
</Grid></Window>
